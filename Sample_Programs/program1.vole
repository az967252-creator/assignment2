; ------------------------------------------------------------
; Vole Machine Program 1
; Purpose: Compute 15 - 9 = 6 using two's complement
;          subtraction and display result on screen.
; ------------------------------------------------------------
200F ; R0 = 0F (15 decimal)
2109 ; R1 = 09 (9 decimal)
22FF ; R2 = FF (all 1s mask for XOR)
9312 ; R3 = R1 XOR R2 (bitwise NOT of 9 = F6)
2401 ; R4 = 01
5534 ; R5 = R3 + R4 (two's complement of 9 = F7)
5605 ; R6 = R0 + R5 (15 + (-9) = 6)
36FF ; Store R6 to screen (memory[FF])
C000 ; Halt
